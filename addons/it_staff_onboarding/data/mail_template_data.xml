<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0"> <!-- Change noupdate to 0 -->
        <record id="email_template_supervisor_onboard_notice" model="mail.template">
            <field name="name">IT Onboarding: Supervisor Notification</field>
            <field name="model_id" ref="model_it_staff_onboard"/>
            <field name="subject">New Staff Onboarded: {{ object.staff_name }} ({{ object.employee_number }})</field>
            <field name="email_from">IT Support &lt;itsupport@lanon.hk&gt;</field>
            <field name="reply_to">itsupport@lanon.hk</field>
            <field name="email_to">{{ object.supervisor_email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <p>Dear Supervisor,</p>
                    <p>Please be informed that the IT onboarding setup for <strong><t t-out="object.staff_name"/></strong> has been completed. Details are below:</p>
                    
                    <table style="width: 100%; max-width: 600px; border-collapse: collapse; margin: 15px 0;">
                        <tr style="background-color: #f8f9fa;">
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6; font-weight: bold;">Sequence No.</td>
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><t t-out="object.sequence_number"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6; font-weight: bold;">Staff Name</td>
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><t t-out="object.staff_name"/></td>
                        </tr>
                        <tr style="background-color: #f8f9fa;">
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6; font-weight: bold;">Employee ID</td>
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><t t-out="object.employee_number"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6; font-weight: bold;">Login Email</td>
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><t t-out="object.email_login or 'N/A'"/></td>
                        </tr>
                        <tr style="background-color: #f8f9fa;">
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6; font-weight: bold;">M365 License Assigned</td>
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6;">
                                <t t-if="object.m365_license_assigned">
                                    <span style="color: green; font-weight: bold;">Yes</span> 
                                    (<t t-out="object.m365_license_type or 'Standard'"/>)
                                </t>
                                <t t-else="">
                                    <span style="color: red;">No</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6; font-weight: bold;">Computer Asset</td>
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><t t-out="object.computer_assigned or 'Not Assigned'"/></td>
                        </tr>
                        <tr style="background-color: #f8f9fa;">
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6; font-weight: bold;">Commence Date</td>
                            <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><t t-out="object.commence_date or 'N/A'"/></td>
                        </tr>
                    </table>

                    <p>Regards,<br/><strong>IT Support Team</strong><br/>Lanon Development Limited</p>
                </div>
            </field>
        </record>
    </data>
</odoo>